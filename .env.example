# Copy to .env and fill in. .env is gitignored — never commit real keys.
# See REGISTRATION.md for where to obtain each one.

# --- Increment 1 (required) ---
OPENAQ_API_KEY=

# --- Increment 1 (may not be required; confirm in Phase 1) ---
AIRNOW_API_KEY=

# --- Increment 2 (not needed yet) ---
EE_PROJECT_ID=
CDS_API_KEY=
ADS_API_KEY=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- Behaviour flags ---
# When 1, ingestion clients read committed offline fixtures instead of hitting the network.
# Results produced under this flag are marked `fixture=true` in the run log and must never
# be reported as findings.
ECOPULSE_USE_FIXTURES=1
